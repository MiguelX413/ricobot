Checks: '-*,bugprone-sizeof-expression,bugprone-suspicious-memset-usage,bugprone-use-after-move,clang-analyzer-core.*,clang-analyzer-cplusplus.*'
WarningsAsErrors: '*,-clang-analyzer-core.NonNullParamChecker'
HeaderFilterRegex: '(^|/)(bot|bot_func|util)\.h$'
ExcludeHeaderFilterRegex: '(^|/)(hlsdk|metamod)/'
